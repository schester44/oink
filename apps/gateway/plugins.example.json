{
  "transcription": {
    "provider": "auto",
    "localWhisper": {
      "modelSize": "base.en",
      "language": "en",
      "threads": 4
    },
    "openaiWhisper": {
      "apiKey": "${OPENAI_API_KEY}"
    }
  },
  "plugins": {
    "websocket": {
      "enabled": true
    },
    "telegram": {
      "enabled": false,
      "botToken": "${TELEGRAM_BOT_TOKEN}",
      "instanceId": "default",
      "notificationChatId": ""
    }
  }
}
